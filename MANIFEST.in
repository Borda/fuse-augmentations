# Manifest syntax https://packaging.python.org/en/latest/guides/using-manifest-in/
recursive-exclude __pycache__  *.py[cod] *.orig

# Include the README
include *.md
recursive-include src/fuse_augmentations *.md

# Include the license file
include LICENSE

# Include every packaged shape-family asset: animal silhouettes, symbol outlines, letter stroke
# graphs. All three share one SVG schema (see fuse_augmentations/data/svgio.py).
recursive-include src/fuse_augmentations/data/zoo *.svg
recursive-include src/fuse_augmentations/data/symbols *.svg
recursive-include src/fuse_augmentations/data/letters *.svg

# Exclude build configs
exclude *.yml
exclude *.yaml

prune .git
prune .github
prune temp*
prune test*
prune docs*
prune examples*
prune experiments*
